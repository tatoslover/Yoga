{
  "name": "mat-and-mind",
  "version": "1.0.0",
  "description": "A distraction-free yoga practice website with trustworthy content",
  "main": "index.js",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "optimize-images": "node scripts/optimize-images.js",
    "generate-thumbnails": "node scripts/generate-thumbnails.js",
    "themes": "node scripts/manage-themes.js",
    "scrape": "node scripts/scrape-yoga-info.js",
    "update-guide": "node scripts/update-guide-content.js",
    "refresh-guide": "npm run scrape && npm run update-guide",
    "refresh-content": "bash scripts/refresh-content.sh",
    "refresh-content:cache": "bash scripts/refresh-content.sh --use-cache",
    "refresh-content:http": "bash scripts/refresh-content.sh --http-only",
    "refresh-content:cache-http": "bash scripts/refresh-content.sh --use-cache --http-only",
    "generate-static": "node scripts/generate-static-content.js",
    "static-build": "node scripts/static-build.js",
    "cleanup": "node scripts/cleanup-old-files.js",
    "cleanup:dry": "node scripts/cleanup-old-files.js --dry-run"
  },
  "keywords": [
    "yoga",
    "videos",
    "11ty",
    "youtube",
    "mindfulness",
    "trusted-content"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "^2.0.1",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "clean-css": "^5.3.2",
    "html-minifier-terser": "^7.2.0",
    "puppeteer": "^21.11.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "sharp": "^0.34.3"
  }
}
