{#
  Content Attribution Component

  This component displays attribution information for content sources.

  Usage:
  {% include "components/content-attribution.njk" with {
    sources: [
      { name: "Source Name", url: "https://example.com", retrievedDate: "August 2023" }
    ],
    lastUpdated: "2023-08-17",
    additionalText: "Optional additional text about the content sources."
  } %}
#}

<div class="content-attribution">
  <h4>Content Sources</h4>
  {% if lastUpdated %}
    <p class="last-updated">Last updated: {{ lastUpdated | formatDate }}</p>
  {% endif %}

  {% if sources and sources.length > 0 %}
    <ul class="sources-list">
      {% for source in sources %}
        <li>
          <a href="{{ source.url }}" target="_blank" rel="noopener">{{ source.name }}</a>
          {% if source.retrievedDate %}
            (Retrieved: {{ source.retrievedDate }})
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if additionalText %}
    <p class="attribution-notice">{{ additionalText }}</p>
  {% else %}
    <p class="attribution-notice">
      Content used for educational purposes with attribution to original sources.
    </p>
  {% endif %}

  <div class="content-disclaimer">
    <p>
      <strong>Disclaimer:</strong> This content is provided for informational purposes only and is not intended as medical advice.
      Always consult with a qualified healthcare provider before beginning any new exercise program.
    </p>
  </div>
</div>
