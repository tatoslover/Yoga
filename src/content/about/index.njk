<script>
  // Keep track of which section is currently open
  let currentOpenSection = null;

  function closeSection(sectionId) {
    // Get the section and hide it
    const section = document.getElementById(sectionId);
    if (section) {
      section.style.display = 'none';

      // Find the card for this section and reset its icon
      const card = document.querySelector(`.category-card[data-category="${sectionId}"]`);
      if (card) {
        card.querySelector('.icon-plus').style.display = 'inline-block';
        card.querySelector('.icon-minus').style.display = 'none';
        card.classList.remove('active');
      }

      // Reset the current open section
      currentOpenSection = null;

      // Scroll back to category cards
      document.querySelector('.category-cards').scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });
    }
  }

  function toggleSection(categoryId, cardElement) {
    // First, reset all cards to inactive state
    document.querySelectorAll('.category-card').forEach(card => {
      card.querySelector('.icon-plus').style.display = 'inline-block';
      card.querySelector('.icon-minus').style.display = 'none';
      card.classList.remove('active');
    });

    // Hide all sections
    document.querySelectorAll('.resource-section').forEach(section => {
      section.style.display = 'none';
    });

    // Is this the section that was already open?
    if (currentOpenSection === categoryId) {
      // We're closing the current section, don't open anything new
      currentOpenSection = null;
      return;
    }

    // Special handling for technology section removal
    if (categoryId === 'technology') {
      // Redirect to approach section instead
      toggleSection('approach');
      return;
    }

    // We're opening a new section
    const section = document.getElementById(categoryId);
    section.style.display = 'block';

    // Show minus icon only on the clicked card
    cardElement.querySelector('.icon-plus').style.display = 'none';
    cardElement.querySelector('.icon-minus').style.display = 'inline-block';
    cardElement.classList.add('active');

    // Update the current open category
    currentOpenSection = categoryId;

    // Scroll to the section
    setTimeout(() => {
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);
  }

  document.addEventListener('DOMContentLoaded', function() {
    // Highlight the card for the current theme in the theme gallery
    const currentTheme = localStorage.getItem('mat-and-mind-theme') || 'forrest';
    const currentCard = document.querySelector(`.credit-card[data-theme="${currentTheme}"]`);
    if (currentCard) {
      currentCard.classList.add('active');
    }
  });
</script>

