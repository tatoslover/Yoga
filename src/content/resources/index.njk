---
layout: base.njk
title: Yoga Resources
description: Learn about the benefits of yoga practice from trusted sources
permalink: /resources/
---

<div class="resources-page">
  <div class="resources-header">
    <h1>Yoga Resources</h1>
    <p class="resources-intro">This page provides information on yoga benefits from trusted sources. Each section contains links to reputable websites where you can learn more.</p>
  </div>

  <div class="category-cards">
    {% for category in resources %}
      {% set categoryName = category.title | replace(' Benefits', '') | replace('Yoga for Specific Conditions', 'Conditions') %}
      <div class="category-card" id="card-{{ category.category }}" data-category="{{ category.category }}" onclick="toggleSection('{{ category.category }}', this)">
        <h2>{{ categoryName }}</h2>
        <div class="card-description">{{ category.description }}</div>
        <div class="card-icon">
          <span class="icon-plus">+</span>
          <span class="icon-minus" style="display: none;">−</span>
        </div>
      </div>
    {% endfor %}
  </div>

  {% for category in resources %}
    {% set categoryName = category.title | replace(' Benefits', '') | replace('Yoga for Specific Conditions', 'Conditions') %}
    <section class="resource-section" id="{{ category.category }}" style="display: none;">
      <div class="section-header">
        <h2>{{ categoryName }}</h2>
        <button class="close-section" aria-label="Close section" onclick="closeSection('{{ category.category }}')">×</button>
      </div>
      <p class="section-description">{{ category.description }}</p>

      <div class="benefits-list">
        {% for benefit in category.benefits %}
          <div class="benefit-card">
            <h3>{{ benefit.title }}</h3>
            <p>{{ benefit.description }}</p>
            <div class="source">
              <a href="{{ benefit.source_url }}" target="_blank" rel="noopener">Source: {{ benefit.source_name }}</a>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endfor %}

</div>

<style>
  .resources-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-lg) var(--spacing-md);
  }

  .resources-header {
    margin-bottom: var(--spacing-xl);
    text-align: center;
  }

  .resources-intro {
    max-width: 800px;
    margin: 0 auto;
    color: var(--color-text-light);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  /* Category Cards */
  .category-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xxl);
  }

  .category-card {
    background: var(--color-background-alt);
    border-radius: var(--border-radius);
    padding: var(--spacing-lg);
    box-shadow: var(--box-shadow-sm);
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 200px;
  }

  .category-card:hover {
    box-shadow: var(--box-shadow-md);
    transform: translateY(-3px);
  }

  .category-card.active {
    box-shadow: var(--box-shadow-md);
    transform: translateY(-3px);
    border-left: 4px solid var(--color-primary);
  }

  .category-card h2 {
    margin-top: 0;
    margin-bottom: var(--spacing-sm);
    color: var(--color-primary);
    font-size: 1.5rem;
  }

  .card-description {
    color: var(--color-text-light);
    font-size: 0.95rem;
    margin-bottom: var(--spacing-md);
    flex-grow: 1;
  }

  .card-icon {
    position: absolute;
    bottom: 15px;
    right: 15px;
    width: 30px;
    height: 30px;
    background: var(--color-primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    line-height: 1;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .category-card:hover .card-icon {
    opacity: 1;
  }

  /* Resource Sections */
  .resource-section {
    margin-bottom: var(--spacing-xxl);
    padding: var(--spacing-lg);
    border-radius: var(--border-radius);
    background: var(--color-background-alt);
    box-shadow: var(--box-shadow-md);
    animation: fadeIn 0.5s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
  }

  .close-section {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 1.5rem;
    line-height: 1;
    padding: 0;
  }

  .close-section:hover {
    background: var(--color-border);
    color: var(--color-primary);
  }

  .section-description {
    margin-bottom: var(--spacing-md);
    color: var(--color-text-light);
  }

  .benefits-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--spacing-lg);
    padding-top: var(--spacing-md);
  }

  .benefit-card {
    background: var(--color-background);
    border-radius: var(--border-radius);
    padding: var(--spacing-lg);
    box-shadow: var(--box-shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .benefit-card h3 {
    margin-top: 0;
    margin-bottom: var(--spacing-sm);
    color: var(--color-primary);
  }

  .source {
    margin-top: auto;
    padding-top: var(--spacing-md);
    font-size: 0.9rem;
    border-top: 1px solid var(--color-border-light);
  }

  .source a {
    color: var(--color-secondary);
    text-decoration: none;
  }

  .source a:hover {
    text-decoration: underline;
  }

  /* Footer removed */

  @media (max-width: 768px) {
    .category-cards {
      grid-template-columns: 1fr;
    }

    .benefits-list {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Keep track of which category is currently open
  let currentOpenCategory = null;

  function closeSection(categoryId) {
    // Get the section and hide it
    const section = document.getElementById(categoryId);
    if (section) {
      section.style.display = 'none';

      // Find the card for this section and reset its icon
      const card = document.getElementById(`card-${categoryId}`);
      if (card) {
        card.querySelector('.icon-plus').style.display = 'inline-block';
        card.querySelector('.icon-minus').style.display = 'none';
        card.classList.remove('active');
      }

      // Reset the current open category
      currentOpenCategory = null;

      // Scroll back to category cards
      document.querySelector('.category-cards').scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });
    }
  }

  function toggleSection(categoryId, cardElement) {
    // Get the section we're toggling
    const section = document.getElementById(categoryId);

    // First, hide all minus icons and reset all cards
    document.querySelectorAll('.category-card').forEach(card => {
      card.querySelector('.icon-plus').style.display = 'inline-block';
      card.querySelector('.icon-minus').style.display = 'none';
      card.classList.remove('active');
    });

    // Hide all sections
    document.querySelectorAll('.resource-section').forEach(section => {
      section.style.display = 'none';
    });

    // Is this the section that was already open?
    if (currentOpenCategory === categoryId) {
      // We're closing the current section, don't open anything new
      currentOpenCategory = null;
      return;
    }

    // We're opening a new section
    section.style.display = 'block';

    // Show minus icon only on the clicked card
    cardElement.querySelector('.icon-plus').style.display = 'none';
    cardElement.querySelector('.icon-minus').style.display = 'inline-block';
    cardElement.classList.add('active');

    // Update the current open category
    currentOpenCategory = categoryId;

    // Scroll to the section
    setTimeout(() => {
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);
  }

  // Initialize when document is loaded
  document.addEventListener('DOMContentLoaded', function() {
    // Nothing needed here - all cards start with plus icons by default
  });
</script>
